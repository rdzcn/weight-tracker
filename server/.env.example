# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# Secret key for JWT signing (generate a random string)
SECRET_KEY=your-secret-key-change-in-production

# Resend API key for sending magic link emails
# Get yours at https://resend.com
RESEND_API_KEY=re_xxxxxxxxx

# Frontend URL for magic link redirects
# Production example: https://w8tracker.ardinho.com
FRONTEND_URL=http://localhost:5173

# Optional comma-separated CORS allowlist.
# Useful when local dev and production should both be allowed.
# Example: http://localhost:5173,https://w8tracker.ardinho.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
